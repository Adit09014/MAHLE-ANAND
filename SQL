-- 2. Assign Roles (1 HR Admin, 1 HOD, 1 Employee)
MERGE dbo.EmpRoles AS target
USING (
    VALUES 
        ('M1001', 'hr',  0, 0),     -- M1001: HR Admin
        ('M1002', 'hod', 1, 1),     -- M1002: HOD (R&D) + Panel Judge
